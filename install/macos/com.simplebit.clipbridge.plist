<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  1. Copy clipbridge to /usr/local/bin.
  2. Pair once: run `clipbridge listen` in Terminal, enter the code it shows on the
     Windows machine, and quit it with Ctrl-C once both sides say "connected".
     The key is saved in ~/.config/clipbridge/key and reused from then on.
  3. Copy this file to ~/Library/LaunchAgents/ and load it with:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.simplebit.clipbridge.plist

  To pair with a different machine later, stop the agent and run
  `clipbridge listen -pair` once in Terminal (two dashes before pair).

  It must be a LaunchAgent (runs in your login session), not a LaunchDaemon,
  or it can't see your clipboard.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.simplebit.clipbridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/clipbridge</string>
    <string>listen</string>
    <string>--log</string>
    <string>/tmp/clipbridge.log</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
